  "phases": [
    {
      "index": 0,
      "label": "怎样只留下主体？",
      "text": "一张图，怎样只留下主体？",
      "captionTextSha256": "e7ce25548ddc8c0595a75aa54ec52d4c7dcdbfda8082cb041428c6de77fdfb93",
      "codepointStart": 0,
      "codepointEnd": 12,
      "firstToken": 0,
      "lastToken": 9
    },
    {
      "index": 1,
      "label": "模型先预测蒙版",
      "text": "rembg 先让模型预测前景蒙版。",
      "captionTextSha256": "0e4114be0a47de7e1b141e2c4f48b62d88a408ffbb865ea9963137c560f95af9",
      "codepointStart": 12,
      "codepointEnd": 29,
      "firstToken": 10,
      "lastToken": 20
    },
    {
      "index": 2,
      "label": "白色保留，黑色透明",
      "text": "白色区域保留，黑色区域变透明。",
      "captionTextSha256": "89af9a8eba471afb1597022bf14e143b906774df2dc79fdd2b624931bc450329",
      "codepointStart": 29,
      "codepointEnd": 44,
      "firstToken": 21,
      "lastToken": 33
    },
    {
      "index": 3,
      "label": "同一蒙版对准原图",
      "text": "把这张蒙版盖回原图，",
      "captionTextSha256": "67bad87d9e1fc0e01dd380759d4875f503881a150965389e7cb2dd65e0054365",
      "codepointStart": 44,
      "codepointEnd": 54,
      "firstToken": 34,
      "lastToken": 42
    },
    {
      "index": 4,
      "label": "背景透明，主体留下",
      "text": "背景消失，主体留下。注意，同一个主体，没有重新画一遍。",
      "captionTextSha256": "c6da5f8f57167cfaa588f43fe1c45d2b48a4048ffe0076ea571b281cedd8ce7e",
      "codepointStart": 54,
      "codepointEnd": 81,
      "firstToken": 43,
      "lastToken": 64
    },
    {
      "index": 5,
      "label": "换个背景，检查边缘",
      "text": "它现在可以放到新的背景里。放大边缘，再检查有没有多留或漏掉的细节。",
      "captionTextSha256": "156c8b281011ed708253516c5411d3adb832147dc387afcd9e2d2e29c29967e7",
      "codepointStart": 81,
      "codepointEnd": 114,
      "firstToken": 65,
      "lastToken": 94
    },
    {
      "index": 6,
      "label": "处理原理示意",
      "text": "这里用合成插画演示处理原理，并没有实际运行模型。",
      "captionTextSha256": "0c609f96df2f3891c134149c3ce5298757cbfeb49d7769dc714c2ee63476b3b4",
      "codepointStart": 114,
      "codepointEnd": 138,
      "firstToken": 95,
      "lastToken": 116
    }
  ],
