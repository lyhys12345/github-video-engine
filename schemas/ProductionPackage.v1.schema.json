{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "planRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "readthrough": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "producingStage": {
          "type": "string",
          "enum": [
            "VALIDATE",
            "RESOLVE_ASSETS",
            "RENDER",
            "VERIFY_MEDIA",
            "PUBLISH"
          ]
        },
        "inputFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "createdAt": {
          "type": "string"
        },
        "integrity": {
          "type": "string",
          "const": "verified"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "sha256",
        "bytes",
        "mediaType",
        "storage",
        "producingStage",
        "inputFingerprint",
        "createdAt",
        "integrity"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "fontFamily": {
          "type": "string",
          "const": "Microsoft YaHei"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "captionSize": {
          "type": "integer",
          "minimum": 30,
          "maximum": 42
        },
        "safeArea": {
          "type": "string",
          "const": "left54-right100-top100-bottom260"
        }
      },
      "required": [
        "id",
        "fontFamily",
        "background",
        "foreground",
        "accent",
        "muted",
        "direction",
        "captionSize",
        "safeArea"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "minItems": 3,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "scriptId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "layout": {
            "type": "string",
            "enum": [
              "hook",
              "purpose",
              "path",
              "loop",
              "compare",
              "limits",
              "closing"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 28
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45
          },
          "labels": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "sourceLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "claimIds": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "scriptId",
          "layout",
          "title",
          "subtitle",
          "labels",
          "sourceLabel",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": [
              "partial-observation",
              "unavailable"
            ]
          },
          "observations": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "observedRange": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "url",
          "status",
          "observations",
          "observedRange",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "authorization": {
      "type": "object",
      "properties": {
        "previewWidth": {
          "type": "number",
          "const": 360
        },
        "previewHeight": {
          "type": "number",
          "const": 640
        },
        "motionWidth": {
          "type": "number",
          "const": 720
        },
        "motionHeight": {
          "type": "number",
          "const": 1280
        },
        "motionScene": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "motionAudioScriptId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "motionSeconds": {
          "type": "number",
          "minimum": 5,
          "maximum": 8
        },
        "maxPreviewAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxPaidUsd": {
          "type": "number",
          "const": 0
        },
        "audio": {
          "type": "string",
          "const": "temporary-local-sapi"
        },
        "fullProduction": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "previewWidth",
        "previewHeight",
        "motionWidth",
        "motionHeight",
        "motionScene",
        "motionAudioScriptId",
        "motionSeconds",
        "maxPreviewAttempts",
        "maxPaidUsd",
        "audio",
        "fullProduction"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "string",
      "const": "agent-authored-graphics-not-target-execution"
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "planRevision",
    "readthrough",
    "style",
    "scenes",
    "references",
    "authorization",
    "origin"
  ],
  "additionalProperties": false,
  "$id": "urn:github-video-engine:ProductionPackage:1.0",
  "$comment": "Zod also enforces cross-field invariants; see docs/contracts.md."
}
