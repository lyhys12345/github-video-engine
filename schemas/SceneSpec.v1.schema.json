{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 48,
      "maximum": 450
    },
    "layout": {
      "type": "string",
      "enum": [
        "title",
        "architecture",
        "closing"
      ]
    },
    "elements": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "eyebrow",
              "title",
              "body",
              "label"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        },
        "required": [
          "role",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "animation": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "const": "fade-slide"
        },
        "entranceFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 45
        }
      },
      "required": [
        "preset",
        "entranceFrames"
      ],
      "additionalProperties": false
    },
    "assetIds": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "durationFrames",
    "layout",
    "elements",
    "animation",
    "assetIds"
  ],
  "additionalProperties": false,
  "$id": "urn:github-video-engine:SceneSpec:1.0",
  "$comment": "Zod also enforces cross-field invariants; see docs/contracts.md."
}
