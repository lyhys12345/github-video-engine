{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "repository": {
      "type": "string",
      "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "evidence": {
      "type": "string",
      "const": "synthetic-demo"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "repository",
    "revision",
    "evidence"
  ],
  "additionalProperties": false,
  "$id": "urn:github-video-engine:Project:1.0",
  "$comment": "Zod also enforces cross-field invariants; see docs/contracts.md."
}
