{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "evidence": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "interpretation": {
          "type": "string",
          "const": "agent-curated-semantic-graph-not-automatic-source-understanding"
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "path",
              "url",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "claims": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "kind": {
                "type": "string",
                "enum": [
                  "documented",
                  "inference"
                ]
              },
              "citations": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "startLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3000
                    }
                  },
                  "required": [
                    "document",
                    "startLine",
                    "endLine",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "id",
              "statement",
              "kind",
              "citations",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "objects": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "kind": {
                "type": "string",
                "enum": [
                  "code",
                  "game",
                  "image",
                  "mask",
                  "cutout",
                  "demo",
                  "http-request",
                  "route-handler",
                  "http-response"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "actors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "role": {
                "type": "string",
                "enum": [
                  "source",
                  "tool",
                  "interpreter",
                  "user"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "operations": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "handoff",
                  "rate-change",
                  "control",
                  "segment",
                  "extract",
                  "composite",
                  "match-route",
                  "send-response"
                ]
              },
              "input": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "output": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "claimIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "actorIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "initialRate": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 500
                  },
                  "rateMultiplier": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "input",
              "output",
              "dependsOn",
              "claimIds",
              "actorIds",
              "parameters"
            ],
            "additionalProperties": false
          }
        },
        "disclosure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "audience",
        "interpretation",
        "sources",
        "claims",
        "objects",
        "actors",
        "operations",
        "disclosure"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "chineseCharsPerSecond": {
          "type": "number",
          "minimum": 2,
          "maximum": 8
        },
        "wordsPerSecond": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "fps",
        "chineseCharsPerSecond",
        "wordsPerSecond"
      ],
      "additionalProperties": false
    },
    "shots": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "beat": {
            "type": "string",
            "enum": [
              "hook",
              "context",
              "mechanism",
              "example",
              "benefit",
              "limitation",
              "closing"
            ]
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "visual": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "claimIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "visualSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 300
          },
          "holdSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 300
          },
          "transitionSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          }
        },
        "required": [
          "id",
          "beat",
          "narration",
          "visual",
          "claimIds",
          "visualSeconds",
          "holdSeconds",
          "transitionSeconds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "evidence",
    "timing",
    "shots"
  ],
  "additionalProperties": false
}
