    },
    {
      "id": "rule",
      "statement": "游戏在未碰撞更新时逐步加速",
      "kind": "documented",
      "rationale": "人工核对官方文档与代码；引文定位不等于自动语义证明",
      "citations": [
        {
          "document": "official",
          "startLine": 309,
          "endLine": 317,
          "quote": "              <pre><code>if (this.currentSpeed &lt; this.config.MAX_SPEED) {\n  this.currentSpeed += this.config.ACCELERATION;\n}</code></pre>\n            </div>\n            <p>\n              The settings are <code>SPEED: 6</code>,\n              <code>ACCELERATION: 0.001</code> and <code>MAX_SPEED: 13</code>.\n              The game runs this branch on an update without a collision.\n            </p>"
        }
      ]
    },
    {
      "id": "rebuild",
      "statement": "重建后的教学游戏可用滑杆设为固定速度",
      "kind": "documented",
      "rationale": "人工核对官方文档与代码；引文定位不等于自动语义证明",
      "citations": [
        {
          "document": "official",
          "startLine": 333,
          "endLine": 341,
          "quote": "              <pre><code id=\"lab-speed-rule\">function advanceSpeed(speed) {\n  return speed &lt; 13 ? speed + 0.001 : speed;\n}</code></pre>\n            </div>\n            <p>\n              The mini-game uses this function for automatic acceleration.\n              Moving the slider supplies a fixed speed instead. Drawing, jump\n              physics and rectangle collision checks are new code for this\n              teaching game; its simulation advances at 60 updates per second."
        }
      ]
