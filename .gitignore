# Dependencies, caches, runtime state and generated execution evidence.
node_modules/
.pnpm-store/
.cache/
.gve/
/work/
/test-output/
/acceptance-output/
/demo-output/
/coverage/
/dist/
/build/
*.tsbuildinfo
*.log
*.tmp
*.partial
*.partial-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
.DS_Store
Thumbs.db

# Credentials and local-only settings.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.npmrc.local

# Media exports stay local; the required licensed font remains versioned.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.flac
*.aac
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.zip
*.7z
*.tar
*.gz

# Keep editable example source, exclude generated deliveries and copied projects.
/examples/**/*preview*/
/examples/**/comparison/
/examples/**/final-delivery/
/examples/**/final-review*/
/examples/**/editable-project/
/examples/**/persisted-job/
/examples/**/preflight*/
/examples/**/review/review-input.json
/examples/evidence-planner-v1/rembg-evidence-retry.json

# Historical machine-specific raw execution receipts; Markdown summaries remain.
/docs/acceptance-*.json
/docs/accepted-*.json
/docs/test-*.json
/docs/recovery-results.json
/docs/clean-cli-proof.json

# Keep policies/instructions and concise results, not frozen candidate archives.
/reviews/*
!/reviews/*.md
!/reviews/*.json
!/reviews/*.mjs
!/reviews/judges-v2/
!/reviews/judges-v2/**
!/reviews/M1/
/reviews/M1/*
!/reviews/M1/gate.json
!/reviews/M2/
